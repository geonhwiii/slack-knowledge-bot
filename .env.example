# Bot Configuration
# 봇이 스스로를 부르는 이름. 워크스페이스마다 다르게 설정한다.
BOT_USERNAME=slack-knowledge-bot

# Slack
# Required
# Slack bot token. - secret
SLACK_BOT_TOKEN=
# Slack signing secret for webhook verification. - secret
SLACK_SIGNING_SECRET=
# Optional
# 워크스페이스 주소 (예: https://myteam.slack.com).
# 원문 링크는 평소 슬랙 API(chat.getPermalink)로 받아오므로 비워둬도 된다.
# 그 호출이 실패했을 때 링크를 직접 조립하기 위한 차선책이다.
SLACK_WORKSPACE_URL=
# Slack app-level token for Socket Mode. - secret
SLACK_APP_TOKEN=
# Override the Slack API base URL.
SLACK_API_URL=

# PostgreSQL
# 봇 상태(구독, 락)와 지식베이스가 같은 DB를 쓴다. pgvector 확장이 필요하다.
# Postgres connection URL. - aliases: DATABASE_URL - secret
POSTGRES_URL=

# LLM
# 추출 / 판정 / 검토에 사용. - secret
ANTHROPIC_API_KEY=

# Embeddings
# 검색용 벡터 생성에 사용. Anthropic은 임베딩 API가 없어 별도 제공자를 쓴다. - secret
OPENAI_API_KEY=
